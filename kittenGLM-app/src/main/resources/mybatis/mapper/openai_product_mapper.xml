<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.kitten.infrastructure.dao.IOpenAIProductDao">

    <resultMap id="openAIProductMap" type="com.kitten.infrastructure.po.OpenAIProductPO">
        <id column="id" property="id"/>
        <result column="product_id" property="productId"/>
        <result column="product_name" property="productName"/>
        <result column="product_description" property="productDescription"/>
        <result column="price" property="price"/>
        <result column="model_types" property="modelTypes"/>
        <result column="status" property="status"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>


    <select id="queryProductList"  resultMap="openAIProductMap">
        select id, product_id, product_name, product_desc, quota, price
        from openai.openai_product
        where is_enabled = 1
        order by sort
    </select>
</mapper>